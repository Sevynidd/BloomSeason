<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="100.8dp"
        android:layout_height="100.8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6.4dp"
        android:layout_marginEnd="12.8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:id="@+id/widget_season"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="32sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_bar"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="14dp"
            android:contentDescription="Jahreslauf des Zyklus"
            android:scaleType="fitXY" />
    </LinearLayout>
</FrameLayout>
