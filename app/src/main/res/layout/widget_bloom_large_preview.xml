<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Frühling · Tag 7"
        android:textColor="#11290F"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="in 18–26 Tagen"
        android:textColor="#11290F"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="nächste Periode"
        android:textColor="#11290F"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="voraussichtlich 21.–29. November"
        android:textColor="#11290F"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5" android:background="#3B5F8C" />
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="8" android:background="#3D6A3A" />
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:background="#7A5B0F" />
        <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="12" android:background="#9B4A28" />
    </LinearLayout>
</LinearLayout>
